--- !u!114 &1220471503
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1220471502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3885e70207c780143b73446e36cad9db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scriptText: {fileID: 1526717468}
  sciprtBar: {fileID: 1993847662}
  announcerAnim: {fileID: 1783757412}
  scripts:
  - "\uB2E4\uC74C \uC18C\uC2DD\uC785\uB2C8\uB2E4."
  - "\uCD5C\uADFC \uB300\uD55C\uBBFC\uAD6D\uC5D0\uC11C\uB294 <color=#FF5858>\uD654\uC7AC</color>,
    <color=#11A400>\uC804\uC5FC\uBCD1</color>, <color=#A8DEFF>\uD64D\uC218</color>,
    <color=#FF6795>\uD3ED\uC5FC</color> \uB4F1\n\uB2E4\uC591\uD55C \uC7AC\uB09C\uB4E4\uC774
    \uC787\uB530\uB77C \uBC1C\uC0DD\uD558\uBA70 \uC2DC\uBBFC\uB4E4\uC758 \uC548\uC804\uC774
    \uC704\uD611\uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD2B9\uD788 \uC608\uACE0 \uC5C6\uC774 \uBC1C\uC0DD\uD558\uB294 <color=#FF5858>\uD654\uC7AC</color>,
    \uAE30\uB85D\uC801\uC778 <color=#FF6795>\uD3ED\uC5FC</color>, \uADF8\uB9AC\uACE0
    \uAC11\uC791\uC2A4\uB7EC\uC6B4 \n<color=#11A400>\uC804\uC5FC\uBCD1</color> \uD655\uC0B0\uC740
    \uC2DC\uBBFC\uB4E4\uC5D0\uAC8C \uD070 \uBD88\uC548\uC744 \uC8FC\uACE0 \uC788\uB294
    \uC0C1\uD669\uC785\uB2C8\uB2E4."
  - "\uD558\uC9C0\uB9CC......"
  - "\uCD5C\uADFC, \uC774\uB7EC\uD55C \uC7AC\uB09C\uC5D0 \uB9DE\uC11C \uC2DC\uBBFC\uB4E4\uC744
    \uBCF4\uD638\uD558\uB294 \uD55C \uC601\uC6C5\uC774 \uB4F1\uC7A5\uD588\uC2B5\uB2C8\uB2E4.\n\uADF8
    \uC774\uB984\uC740 \uBC14\uB85C  <b><color=#B0FFA8>\"\uC138\uC774\uD504\uD2F0
    \uD788\uC5B4\uB85C\"</color></b> \uC785\uB2C8\uB2E4!"
  - "<b><color=#B0FFA8>\"\uC138\uC774\uD504\uD2F0 \uD788\uC5B4\uB85C\"</color></b>\uB294
    <color=#FF5858>\uD654\uC7AC \uC9C4\uC555</color>\uBD80\uD130 <color=#11A400>\uC804\uC5FC\uBCD1
    \uBC29\uC5ED</color>, <color=#A8DEFF>\uD64D\uC218 \uAD6C\uC870</color>, <color=#FF6795>\uD3ED\uC5FC
    \uB300\uC751</color>\uAE4C\uC9C0, \uB2E4\uC591\uD55C \uC7AC\uB09C \uC0C1\uD669\uC5D0\uC11C
    \uC2DC\uBBFC\uB4E4\uC744 \uC9C0\uD0A4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uACFC\uC5F0 \uC774 \uC601\uC6C5 \uB355\uBD84\uC5D0 \uC2DC\uBBFC\uB4E4\uC774
    \uC7AC\uB09C\uC5D0 \uB300\uD55C \uB450\uB824\uC6C0 \uC5C6\uC774 \uC548\uC804\uC744
    \uB418\uCC3E\uC744 \uC218 \uC788\uC744\uAE4C\uC694?"
  - "\uC774\uC0C1, \uC694\uC998 \uD654\uC7AC\uC600\uB358 <b><color=#B0FFA8>\"\uC138\uC774\uD504\uD2F0
    \uD788\uC5B4\uB85C\"</color></b>\uC5D0 \uAD00\uD55C \uB0B4\uC6A9\uC774\uC600\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uC74C \uC18C\uC2DD\uC785\uB2C8\uB2E4...."
  typingSpeed: 0.017
